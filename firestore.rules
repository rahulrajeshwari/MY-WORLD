rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function admin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/myWorldAdmins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/myWorldAdmins/$(request.auth.uid)).data.active == true;
    }

    function text(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }

    match /myWorldAdmins/{uid} {
      allow get: if owns(uid);
    }

    match /myWorldProfiles/{uid} {
      allow get: if owns(uid);
      allow create, update: if owns(uid) &&
        request.resource.data.keys().hasOnly(['name', 'email']) &&
        text(request.resource.data.name, 1, 80) &&
        text(request.resource.data.email, 0, 254);
    }

    match /myWorldProfiles/{uid}/billingBackups/{backupId} {
      allow get, list: if owns(uid);
      allow create: if owns(uid) && backupId.matches('^[a-f0-9]{64}$') &&
        request.resource.data.keys().hasOnly(['payload', 'createdAt']) &&
        text(request.resource.data.payload, 1, 900000) &&
        request.resource.data.createdAt == request.time;
    }

    match /myWorldRepairs/{repairId} {
      allow get: if admin() || owns(resource.data.uid);
      allow list: if request.query.limit <= 50 && (admin() || owns(resource.data.uid));
      allow create: if owns(request.resource.data.uid) &&
        request.resource.data.keys().hasOnly(['uid', 'model', 'problem', 'status', 'createdAt', 'updatedAt']) &&
        text(request.resource.data.model, 0, 100) &&
        text(request.resource.data.problem, 1, 800) &&
        request.resource.data.status == 'Received' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if admin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status in ['Received', 'In progress', 'Ready', 'Completed', 'Cancelled'] &&
        request.resource.data.updatedAt == request.time;
    }
  }
}
